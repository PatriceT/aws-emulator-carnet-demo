# Image commune : AWS Emulator + CLI AWS v2 + psql + Terraform.
# Sert aux services « emulateur », « test » et « terraform ».
FROM ubuntu:24.04
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip postgresql-client \
 && curl -fsSLo /tmp/aws-emulator.deb https://downloads.aws.com/aws-emulator/packages/aws-emulator/LTS/latest/aws-emulator_amd64.deb \
 && apt-get install -y /tmp/aws-emulator.deb \
 && curl -fsSLo /tmp/awscli.zip https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip \
 && unzip -q /tmp/awscli.zip -d /tmp && /tmp/aws/install \
 && rm -rf /tmp/aws /tmp/awscli.zip /tmp/aws-emulator.deb /var/lib/apt/lists/*
ARG TERRAFORM_VERSION=1.17.2
RUN curl -fsSLo /tmp/terraform.zip https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip \
 && unzip -q /tmp/terraform.zip terraform -d /usr/local/bin && rm /tmp/terraform.zip
WORKDIR /app
